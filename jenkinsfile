pipeline {
    // 默认允许流水线在任意可用的 Jenkins Agent 上运行
    agent any
    //环境变量
    environment{
        NETLIFY_SITE_ID = '1aea8aca-7a2b-4ac3-bf0e-0eb41c903963'
        NETLIFY_AUTH_TOKEN = credentials('netlify-dash-token')
    }

    stages {
        // 安装项目依赖并构建应用
        stage('Build') {
            agent {
                docker {
                    // 在轻量级 Node.js 18 容器中执行本阶段
                    image 'node:18-alpine'
                    // 复用当前工作空间，确保容器能够访问已检出的代码
                    reuseNode true
                }
            }
            steps {
                // 执行构建所需的 Shell 命令
                sh '''
                   # 查看构建前的工作空间内容
                   ls -la
                   # 输出 Node.js 与 npm 版本，便于排查环境问题
                   node --version
                   npm --version
                   # 根据 package-lock.json 进行可重复的依赖安装
                   npm ci
                   # 执行 package.json 中定义的构建脚本
                   npm run build
                   # 查看构建后生成的文件
                   ls -la
                '''
            }
        }
        //测试
        stage('Run Test'){
            //同步执行
            parallel{
                stage('test'){
                    agent {
                        //在test阶段拉取nodejs环境
                        docker {
                            // 在轻量级 Node.js 18 容器中执行本阶段
                            image 'node:18-alpine'
                            // 复用当前工作空间，确保容器能够访问已检出的代码
                            reuseNode true
                        }
                    }
            
                steps{
                    //查看index.hmtl文件是否在build目录里
                    sh '[ -f build/index.html ]'              
                    //CI=true 是临时环境变量，告诉测试工具当前运行在 CI 环境中，避免进入交互式/watch 模式
                    sh 'CI=true npm test'
                }

                post {
                    always{
                        //无论流水线成功或失败，都收集 JUnit XML 测试报告并在 Jenkins 中展示测试结果
                        junit 'jtest-results/junit.xml'      
                        }
                    }

            }
                stage('E2E'){
                    agent {
                        //在ESE测试阶段拉取playwright
                        docker {
                            // 拉取playwright镜像
                            image 'mcr.microsoft.com/playwright:v1.39.0-jammy'
                            // 复用当前工作空间，确保容器能够访问已检出的代码
                            reuseNode true
                        }
                    }           
                    steps{
                    //安装静态服务器 
                    sh 'npm install serve'
                    //部署服务,写入项目目录的/node_modules,&把这个进程放到后台运行
                    sh 'node_modules/.bin/serve -s build &'
                    //等待服务器启动完成后才能进行测试,让当前 Shell 进程暂停 10 秒
                    sh 'sleep 10'
                    //用 Playwright 运行自动化测试的命令，并生成测试报告
                    sh 'npx playwright test --reporter=html'

                    }

                    post {
                        always{
                            //发布html报告
                            publishHTML([allowMissing: false, alwaysLinkToLastBuild: false, icon: '', keepAll: false, reportDir: 'playwright-report', reportFiles: 'index.html', reportName: 'playwrightHTML Report', reportTitles: '', useWrapperFileDirectly: true])
                              }
                         }

                }


            }
        }

        //部署
        stage('deploy'){
            agent {
                docker {
                    // 在轻量级 Node.js 18 容器中执行本阶段
                    image 'node:18-alpine'
                    // 复用当前工作空间，确保容器能够访问已检出的代码
                    reuseNode true
                }
            }
            steps {
                // 执行构建所需的 Shell 命令
                sh '''
                   # 安装netlify-cli命令行工具,安装在当前项目的node_modules目录下
                   npm install netlify-cli
                   # 调用在当前项目目录下的netlify 查看版本
                   node_modules/.bin/netlify --version
                   # 打印要部署的project id
                   echo "deploing to production Site ID: $NETLIFY_SITE_ID"
                   # 调用在当前项目目录下的netlify 查看Netlify CLI的登录状态
                   node_modules/.bin/netlify status
                   # 调用在当前项目目录下的netlify 开始部署项目,项目文件夹名为build
                   node_modules/.bin/netlify deploy --dir=build --prod --no-build
                '''
            }
        }

    }
}
